{
  "manifest_version": 3,
  "name": "GA Scroll Scale (Chrome 专用滚动缩放)",
  "version": "1.0",
  "description": "按倍率降低网页滚动速度（默认 0.5 = 一半）。只作用于 Chrome，不影响其它应用。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["scale.js"]
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "GA Scroll Scale" }
}
